# --- Приложение ---
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=5000
# Базовый URL API для web-сервиса (в compose — http://api:5000)
API_BASE_URL=http://localhost:5000

# --- Web-сервис (HTML-визуализация) ---
# Web читает только APP_ENV, LOG_LEVEL, API_BASE_URL и переменные ниже;
# DATABASE_URL/REDIS_URL/GIGACHAT_* ему не нужны.
WEB_HOST=0.0.0.0
WEB_PORT=8000

# --- PostgreSQL + pgvector ---
# asyncpg DSN (для SQLAlchemy async / приложения)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edu_platform_kurses
# синхронный DSN для утилит (psql/pg_dump)
DSN=postgresql://postgres:postgres@localhost:5432/edu_platform_kurses

# --- Redis Streams ---
REDIS_URL=redis://localhost:6379/0
STREAM_REQUESTS=rag.requests
STREAM_DEAD=rag.dead
STREAM_EVENTS=rag.events
CONSUMER_GROUP=rag-workers
JOB_MAX_ATTEMPTS=3
CONSUMER_PENDING_IDLE_MS=60000
STREAM_BLOCK_MS=5000

# --- Индексация описаний курсов ---
STREAM_INDEX=rag.index.requests
INDEX_DLQ=rag.index.dead
INDEX_GROUP=rag-indexers
INDEX_CONSUMER_NAME=indexer-1

# --- Cron-очередь (периодические задачи) ---
STREAM_CRON=rag.cron
CRON_DLQ=rag.cron.dead
CRON_GROUP=rag-cron
CRON_INTERVAL_SECONDS=3600
JOB_RETENTION_DAYS=7

# --- Ретенция Redis-стримов (approximate MAXLEN) ---
REDIS_STREAM_MAXLEN=10000
REDIS_STREAM_EVENTS_MAXLEN=1000

# --- JWT-аутентификация (access + refresh в httpOnly cookie) ---
# Ключ подписи access-токена. Пусто — генерируется эфемерный на процесс (только для dev).
JWT_SECRET=
JWT_ALGORITHM=HS256
# Время жизни access-токена в секундах (по умолчанию 15 минут).
ACCESS_TOKEN_TTL=900
# Время жизни refresh-токена в секундах (по умолчанию 14 дней).
REFRESH_TOKEN_TTL=1209600
# Secure-cookie (включать при работе через HTTPS).
COOKIE_SECURE=false

# --- Пароли пользователей ---
# Ключ обратимого шифрования паролей (Fernet, urlsafe-base64).
# Сгенерировать: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Реальный ключ храните только в локальном .env, не коммитьте.
PASSWORD_KEY=

# --- Роли и администратор ---
# Вход — по email/паролю из таблицы users; права определяются ролью.
# Регистрация на портале создаёт только student или teacher.
# Администратор создаётся только скриптом:
#   python -m courses_assistant.scripts.create_user \
#       --email admin@example.com --password secret --role admin

# --- Embeddings (Ollama, nomic-embed-text) ---
OLLAMA_URL=http://localhost:11434/api/embed
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
RETRIEVAL_TOP_K=5

# --- GigaChat (LLM) ---
GIGACHAT_CREDENTIALS=your_credentials_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL=false
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2

# --- Stepik (скрипты импорта) ---
# Токен Stepik храните только локально, не коммитьте.
access_token=
